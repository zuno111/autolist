{
  "name": "autolist",
  "version": "1.0.0",
  "description": "AutoList - 아마존 상품 등록 자동 대행 플랫폼 (STUDIO ig)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test/run.js",
    "vapid": "node scripts/vapid.js",
    "build:exe": "pkg . --no-bytecode --public-packages \"*\" --public"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/xlsx/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.17.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "pg": "^8.12.0",
    "playwright": "^1.45.0",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0"
  }
}
